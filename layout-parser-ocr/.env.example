APP_NAME=document-analysis-service
STORAGE_DIR=storage
PUBLIC_BASE_URL=http://localhost:8001
MAX_UPLOAD_MB=100
RENDER_DPI=200
LAYOUT_MODEL_CONFIG=https://huggingface.co/layoutparser/detectron2/resolve/main/PubLayNet/faster_rcnn_R_50_FPN_3x/config.yml
LAYOUT_MODEL_WEIGHTS=https://huggingface.co/layoutparser/detectron2/resolve/main/PubLayNet/faster_rcnn_R_50_FPN_3x/model_final.pth
LAYOUT_MODEL_DEVICE=cpu
LAYOUT_SCORE_THRESHOLD=0.50
INCLUDE_PDF_NATIVE_BLOCKS=true
INCLUDE_VISUAL_TEXT_BLOCKS=true
VISUAL_TEXT_FOR_PDF=true
RECLASSIFY_LAYOUT_WITH_VISUAL_TEXT=true
INCLUDE_FULL_PAGE_BLOCK=true
INCLUDE_IMAGE_TARGETS=false
SAVE_DEBUG_CROPS=false
OCR_TEXT_CANVAS_MAX_LONG_SIDE=1600
OCR_TEXT_CANVAS_MAX_PIXELS=2000000
OCR_TEXT_CANVAS_MIN_TEXT_HEIGHT=20
OCR_TEXT_CANVAS_KEEP_ORIGINAL=true
OCR_TEMP_ROOT=storage/ocr-temp
PADDLE_OCR_BASE_DIR=storage/paddleocr
OCR_CANDIDATE_STRATEGY=first
OCR_MAX_CONCURRENT_REQUESTS=1
OCR_BUSY_STATUS_CODE=503
OCR_TEMP_CLEANUP_MAX_AGE_SECONDS=21600
OCR_JOB_QUEUE_SIZE=5
OCR_JOB_WORKERS=1
OCR_JOB_RETENTION_SECONDS=3600
OCR_LOAD_MODEL_ON_STARTUP=false
LOAD_MODEL_ON_STARTUP=false
CALLBACK_TIMEOUT_SECONDS=10
